#!/usr/bin/env bash
# vaultmem-judge: the `judge` extension: typed decisions about vault content
# from an evaluation model behind Vercel AI Gateway. All of vaultmem's HTTP
# lives here; the core script never opens a socket.
#
# Usage:
#   vaultmem-judge <name> [--vault <id>] [--gate <question>] [--format json|tsv]
#                         [--subject <text>]        state on stdin
#   vaultmem-judge list                 judges available (user overrides shipped)
#   vaultmem-judge doctor [--live]      config, key, and judge-file checks
#   vaultmem-judge log [-n N]           tail the decision log (default 20 rows)
#   vaultmem-judge feedback <id> right|wrong    mark a logged decision (offline)
#   vaultmem-judge calibration [--judge <name>] [--format tsv|json]
#                                       accuracy per confidence bucket (offline)
#   vaultmem-judge route [--subject <text>]     vault, folder, and MOC for a
#                                       summary on stdin (consenting vaults only)
#   vaultmem-judge dupes [--vault <id>] [--subject <text>]
#                                       notes that already cover a summary on stdin
#   vaultmem-judge rerank --vault <id> [--vault <id>...]
#                                       score search candidates (JSON on stdin) 0 to 3
#   vaultmem-judge bench [--fixture <tsv>] [--vault <id>] [-n N] [--format tsv|json]
#                                       search order vs reranked order on a fixture
#   vaultmem-judge index-drift --vault <id>   is each Agent Index row (JSON on
#                                       stdin, at most 5) accurate for its note
#   vaultmem-judge prompt               UserPromptSubmit hook: one line on a
#                                       confident "why" question, else nothing
#
# Exit codes (the contract core and hooks rely on):
#   0   ok; with --gate, the answer is yes
#   1   --gate only: the answer is no
#   2   --gate only: abstain (between thresholds, or below min_confidence);
#       route: the top vault is below min_confidence
#   3   unavailable: disabled, no consent, no key, timeout, HTTP error, bad response
#   64  usage error; rerank, index-drift: malformed stdin
#   prompt exits 0 in every case but a usage error.
#
# Config is never parsed here. It comes from `"$VAULTMEM_BIN" judge config`,
# which prints `ext.judge.<key>=<value>` lines, then `vault.<id>.judge=true|false`.
#
# bash 3.2 floor applies (see docs/development.md). Deps: curl, jq.
# Reference: docs/judge.md. Design: docs/design/judge-extension.md.
set -uo pipefail

PROG="vaultmem-judge"
KNOWN_KEYS="enabled model base_url zdr timeout_ms key_file log rerank hook_judges"
LOG_MAX_BYTES_DEFAULT=5242880 # 5 MiB; one rotated generation (judge.jsonl.1)
LIVE_STATE="The build failed with exit code 1."

TMPD=""
CFG=""
KEY=""

cleanup() { [ -n "$TMPD" ] && rm -rf "$TMPD"; }
trap cleanup EXIT

usage_err() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	printf 'usage: %s <name> [--vault <id>] [--gate <question>] [--format json|tsv]\n' "$PROG" >&2
	printf '       %s list | doctor [--live] | log [-n N]\n' "$PROG" >&2
	printf '       %s feedback <id> right|wrong | calibration [--judge <name>]\n' "$PROG" >&2
	printf '       %s route [--subject <text>] | dupes [--vault <id>] [--subject <text>]\n' "$PROG" >&2
	printf '       %s rerank --vault <id> [--vault <id>...] | bench [--fixture <tsv>] [--vault <id>] [-n N]\n' "$PROG" >&2
	printf '       %s index-drift --vault <id> | prompt\n' "$PROG" >&2
	exit 64
}

# Exit 3 with one stderr line and nothing on stdout. Any key text is redacted
# in case a gateway error message ever echoes it back.
unavailable() {
	local msg="$1"
	[ -n "$KEY" ] && msg="${msg//"$KEY"/[redacted]}"
	printf '%s: unavailable: %s\n' "$PROG" "$msg" >&2
	exit 3
}

mktmp() {
	[ -n "$TMPD" ] && return 0
	TMPD=$(mktemp -d "${TMPDIR:-/tmp}/vaultmem-judge.XXXXXX") || return 1
	chmod 700 "$TMPD"
}

# Directory of this script after symlink resolution (install.sh may symlink it).
self_dir() {
	local src="$0" dir link
	while [ -L "$src" ]; do
		dir=$(cd -P "$(dirname "$src")" && pwd)
		link=$(readlink "$src")
		case "$link" in
		/*) src="$link" ;;
		*) src="$dir/$link" ;;
		esac
	done
	cd -P "$(dirname "$src")" && pwd
}

SHIPPED_DIR="$(self_dir)/judges"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vaultmem/judges"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/vaultmem/judge.jsonl"

valid_name() {
	case "$1" in
	"" | *[!A-Za-z0-9._-]* | .*) return 1 ;;
	esac
	return 0
}

# --- config (the core/extension contract) --------------------------------------

vaultmem_bin() {
	if [ -n "${VAULTMEM_BIN:-}" ]; then
		printf '%s\n' "$VAULTMEM_BIN"
	else
		command -v vaultmem 2>/dev/null
	fi
}

load_config() {
	local bin
	bin=$(vaultmem_bin) || return 1
	[ -n "$bin" ] || return 1
	CFG=$("$bin" judge config 2>/dev/null) || return 1
	[ -n "$CFG" ]
}

# cfg_raw <full.key>: value as printed by core, empty when absent.
cfg_raw() {
	printf '%s\n' "$CFG" | awk -v k="$1" '
		{ i = index($0, "="); if (i && substr($0, 1, i - 1) == k) { print substr($0, i + 1); exit } }'
}

# cfg <key> <default>: an [ext.judge] key. Core fills defaults; these are a
# second line of defense, and the conservative ones (enabled=false, zdr=true).
cfg() {
	local v
	v=$(cfg_raw "ext.judge.$1")
	printf '%s\n' "${v:-$2}"
}

expand_tilde() {
	case "$1" in
	\~) printf '%s\n' "$HOME" ;;
	\~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# base_url must be https, except a loopback host: the key rides on every call.
base_url_ok() {
	case "$1" in
	https://?*) return 0 ;;
	http://localhost | http://localhost[:/]* | http://127.0.0.1 | http://127.0.0.1[:/]*) return 0 ;;
	esac
	return 1
}

# --- key -----------------------------------------------------------------------

# key_file_mode_ok <file>: refuse anything wider than 600. Reads the `ls -l`
# mode string because `stat` flags differ between macOS and Linux.
key_file_mode_ok() {
	local perms
	perms=$(ls -ldL "$1" 2>/dev/null) || return 1
	case "${perms:0:10}" in
	-[r-][w-]-------) return 0 ;;
	esac
	return 1
}

# load_key: sets KEY. Returns 1 with KEY_ERR set on failure. Never prints KEY.
KEY_ERR=""
KEY_SRC=""
load_key() {
	local file
	if [ -n "${AI_GATEWAY_API_KEY:-}" ]; then
		KEY="$AI_GATEWAY_API_KEY"
		KEY_SRC="AI_GATEWAY_API_KEY"
		return 0
	fi
	file=$(expand_tilde "$(cfg key_file "$HOME/.config/vaultmem/ai-gateway.key")")
	KEY_SRC="$file"
	if [ ! -f "$file" ]; then
		KEY_ERR="no key: AI_GATEWAY_API_KEY is unset and key_file does not exist ($file)"
		return 1
	fi
	if ! key_file_mode_ok "$file"; then
		KEY_ERR="key_file permissions are wider than 600 ($file)"
		return 1
	fi
	KEY=$(head -n 1 "$file" | tr -d '[:space:]')
	if [ -z "$KEY" ]; then
		KEY_ERR="key_file is empty ($file)"
		return 1
	fi
	return 0
}

# --- judge files -----------------------------------------------------------------

judge_path() {
	if [ -f "$USER_DIR/$1.json" ]; then
		printf '%s\n' "$USER_DIR/$1.json"
	elif [ -f "$SHIPPED_DIR/$1.json" ]; then
		printf '%s\n' "$SHIPPED_DIR/$1.json"
	else
		return 1
	fi
}

# Prints one problem per line; empty output means the judge file is valid.
judge_problems() {
	if ! jq -e . "$1" >/dev/null 2>&1; then
		printf 'not valid JSON\n'
		return 0
	fi
	jq -r '
		def posint: type == "number" and . > 0 and . == floor;
		def prob: type == "number" and . >= 0 and . <= 1;
		def qtype_ok: type == "object" and (.type == "boolean" or .type == "choice" or .type == "score");
		if type != "object" then "top level is not an object" else
		  . as $j
		  | (if .version != 1 then "version must be 1" else empty end),
		    (if has("max_state_bytes") and (.max_state_bytes | posint | not)
		     then "max_state_bytes must be a positive integer" else empty end),
		    (if has("truncate") and .truncate != "head" and .truncate != "tail"
		     then "truncate must be \"head\" or \"tail\"" else empty end),
		    (if (.questions | type) != "object" or (.questions | length) == 0
		     then "questions must be a non-empty object"
		     else (.questions | to_entries[] | select(.value | qtype_ok | not)
		           | "question \(.key): type must be boolean, choice, or score") end),
		    (if has("thresholds") | not then empty
		     elif (.thresholds | type) != "object" then "thresholds must be an object"
		     else (.thresholds | to_entries[] | . as $e
		           | if ($j.questions | type) == "object" and ($j.questions | has($e.key) | not)
		             then "thresholds.\($e.key): no such question"
		             elif ($e.value | type) != "object" then "thresholds.\($e.key): must be an object"
		             elif ($e.value | to_entries | all(.value | prob) | not)
		             then "thresholds.\($e.key): values must be numbers from 0 to 1"
		             else empty end) end)
		end' "$1"
}

# --- decision log ----------------------------------------------------------------

sha256_file() {
	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	else
		return 1
	fi
}

# log_append <json-row>. Never fails the call: any rotation or write problem
# skips the row.
log_append() {
	local dir max size
	dir=$(dirname "$LOG_FILE")
	mkdir -p "$dir" 2>/dev/null || return 0
	max="${VAULTMEM_JUDGE_LOG_MAX_BYTES:-$LOG_MAX_BYTES_DEFAULT}"
	case "$max" in
	"" | *[!0-9]*) max=$LOG_MAX_BYTES_DEFAULT ;;
	esac
	if [ -f "$LOG_FILE" ]; then
		size=$(wc -c <"$LOG_FILE" 2>/dev/null | tr -d '[:space:]')
		case "$size" in
		"" | *[!0-9]*) return 0 ;;
		esac
		if [ "$size" -ge "$max" ]; then
			mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || return 0
		fi
	fi
	{ printf '%s\n' "$1" >>"$LOG_FILE"; } 2>/dev/null || return 0
}

# --- the gateway call ------------------------------------------------------------

# gateway_post <body-file> <resp-file>: POST /v1/evaluate. Sets HTTP_CODE,
# LATENCY_MS, CURL_RC. The key travels only on curl's stdin (`--config -`),
# written by the printf builtin: never argv, never a file.
HTTP_CODE=0
LATENCY_MS=0
CURL_RC=0
gateway_post() {
	local body="$1" resp="$2" url max_time esc meta
	url="$(cfg base_url "https://ai-gateway.vercel.sh")"
	url="${url%/}/v1/evaluate"
	max_time=$(awk -v ms="$(cfg timeout_ms 1500)" 'BEGIN { printf "%.3f", ms / 1000 }')
	esc="${KEY//\\/\\\\}"
	esc="${esc//\"/\\\"}"
	meta=$(printf 'header = "Authorization: Bearer %s"\n' "$esc" |
		curl --silent --max-time "$max_time" --config - \
			--request POST \
			--header 'Content-Type: application/json' \
			--data-binary "@$body" \
			--output "$resp" \
			--write-out '%{http_code} %{time_total}' \
			"$url" 2>/dev/null)
	CURL_RC=$?
	HTTP_CODE=$(printf '%s' "$meta" | awk '{ print ($1 ~ /^[0-9]+$/) ? $1 + 0 : 0 }')
	LATENCY_MS=$(printf '%s' "$meta" | awk '{ gsub(",", ".", $2); printf "%d", $2 * 1000 }')
	HTTP_CODE="${HTTP_CODE:-0}"
	LATENCY_MS="${LATENCY_MS:-0}"
}

# --- the shared request path ------------------------------------------------------
# Every call that sends state (a named judge, `route`, `dupes`) runs the same
# checks, the same request, and the same log row. The caller does its own
# consent check first; nothing here decides which vault may send.

# egress_ready: the checks between consent and the network. Sets ZDR and
# TIMEOUT_MS, loads the key, and makes the temp dir.
ZDR=true
TIMEOUT_MS=1500
egress_ready() {
	local base_url
	base_url=$(cfg base_url "https://ai-gateway.vercel.sh")
	base_url_ok "$base_url" || unavailable "base_url must be https (or a loopback http host)"
	TIMEOUT_MS=$(cfg timeout_ms 1500)
	case "$TIMEOUT_MS" in
	"" | *[!0-9]* | 0) unavailable "timeout_ms must be a positive integer" ;;
	esac
	ZDR=$(cfg zdr true)
	[ "$ZDR" = "false" ] || ZDR=true
	command -v curl >/dev/null 2>&1 || unavailable "curl is not installed"
	load_key || unavailable "$KEY_ERR"
	mktmp || unavailable "cannot create a temp dir"
}

# fit_state <in> <out> <max-bytes> <head|tail>: copy, cut to max-bytes from the
# chosen end. Sets TRUNCATED.
TRUNCATED=false
fit_state() {
	local size
	size=$(wc -c <"$1" | tr -d '[:space:]')
	if [ "$size" -gt "$3" ]; then
		TRUNCATED=true
		if [ "$4" = "tail" ]; then
			tail -c "$3" "$1" >"$2"
		else
			head -c "$3" "$1" >"$2"
		fi
	else
		cp "$1" "$2"
	fi
}

# evaluate <judge> <vault> <subject> <state-file> <questions-file> <required> <resp-file>
# POSTs one request, validates the response, and logs one row. <required> is a
# space-separated list of question names the answers must include. An empty
# <vault> logs the response's `vault` choice (route's multi-vault request).
# Sets CALL_ID. Any failure logs an error row and exits 3.
CALL_ID=""
evaluate() {
	local name="$1" vault="$2" subject="$3" state="$4" questions="$5" required="$6" resp="$7"
	local body="$TMPD/body.json" model
	model=$(cfg model "typesafe-ai/jev")
	jq -n --rawfile state "$state" --slurpfile q "$questions" \
		--arg model "$model" --argjson zdr "$ZDR" '
		{ model: $model, state: $state, questions: $q[0] }
		+ (if $zdr then { providerOptions: { gateway: { zeroDataRetention: true } } } else {} end)
		' >"$body" || unavailable "could not build the request body"

	gateway_post "$body" "$resp"

	local id ts sha log_on err_type="" err_msg="" reason=""
	ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	sha=$(sha256_file "$state") || sha=""
	id="$(date -u +%Y%m%dT%H%M%SZ)-$(printf '%s%s%s' "$sha" "$$" "$RANDOM" | cksum | awk '{ printf "%04x", $1 % 65536 }')"
	log_on=$(cfg log true)

	if [ "$CURL_RC" -ne 0 ]; then
		err_type="transport_error"
		err_msg="curl exit $CURL_RC"
		[ "$CURL_RC" -eq 28 ] && err_msg="timeout after ${TIMEOUT_MS}ms (curl exit 28)"
		reason="$err_msg"
	elif [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
		err_type=$(jq -r '.error.type // "http_error" | tostring' "$resp" 2>/dev/null) || err_type="http_error"
		err_msg=$(jq -r '.error.message // "" | tostring' "$resp" 2>/dev/null) || err_msg=""
		err_type="${err_type:-http_error}"
		if jq -e '(.error.param | objects | .name) == "ZdrUnauthorizedError"' "$resp" >/dev/null 2>&1; then
			reason="HTTP $HTTP_CODE $err_type: the gateway refused zero data retention; not retried without it"
		else
			reason="HTTP $HTTP_CODE $err_type: $err_msg"
		fi
	elif ! jq -e --arg req "$required" '
		(.answers | type) == "object" and (.answers | length) > 0
		and (.answers | to_entries | all(
		  (.value | type) == "object" and
		  (if .value.type == "boolean" then (.value.probability | type) == "number"
		   elif .value.type == "choice" then (.value.choice | type) == "string"
		     and (.value.probabilities | type) == "object"
		   elif .value.type == "score" then (.value.score | type) == "number"
		   else false end)))
		and (.answers as $a | $req | split(" ") | map(select(. != "")) | all(. as $k | $a | has($k)))' \
		"$resp" >/dev/null 2>&1; then
		err_type="bad_response"
		err_msg="response body is not a valid evaluate response"
		reason="HTTP $HTTP_CODE: $err_msg"
	fi

	if [ -n "$err_type" ]; then
		[ -n "$KEY" ] && err_msg="${err_msg//"$KEY"/[redacted]}"
		if [ "$log_on" = "true" ]; then
			log_append "$(jq -nc --arg id "$id" --arg ts "$ts" --arg judge "$name" --arg vault "$vault" \
				--arg subject "$subject" --arg model "$model" --arg sha "$sha" \
				--argjson truncated "$TRUNCATED" --argjson latency "$LATENCY_MS" --argjson http "$HTTP_CODE" \
				--arg etype "$err_type" --arg emsg "$err_msg" '
				{ id: $id, ts: $ts, judge: $judge,
				  vault: (if $vault == "" then null else $vault end),
				  subject: (if $subject == "" then null else $subject end),
				  model: $model, state_sha256: $sha, truncated: $truncated, answers: null,
				  input_tokens: null, cost: null, market_cost: null,
				  latency_ms: $latency, http: $http, feedback: null,
				  error: { type: $etype, message: $emsg } }')"
		fi
		unavailable "$reason"
	fi

	if [ "$log_on" = "true" ]; then
		log_append "$(jq -c --arg id "$id" --arg ts "$ts" --arg judge "$name" --arg vault "$vault" \
			--arg subject "$subject" --arg model "$model" --arg sha "$sha" \
			--argjson truncated "$TRUNCATED" --argjson latency "$LATENCY_MS" --argjson http "$HTTP_CODE" '
			{ id: $id, ts: $ts, judge: $judge,
			  vault: (if $vault != "" then $vault else (.answers.vault.choice // null) end),
			  subject: (if $subject == "" then null else $subject end),
			  model: (.model // $model), state_sha256: $sha, truncated: $truncated,
			  answers: .answers,
			  input_tokens: (.usage.inputTokens // null),
			  cost: (.providerMetadata.gateway.cost // null),
			  market_cost: (.providerMetadata.gateway.marketCost // null),
			  latency_ms: $latency, http: $http, feedback: null }' "$resp")"
	fi
	CALL_ID="$id"
}

# consenting_vaults: registry ids with judge = true, one per line, in config order.
consenting_vaults() {
	printf '%s\n' "$CFG" | awk '/^vault\.[^=]*\.judge=true$/ { s = $0; sub(/^vault\./, "", s); sub(/\.judge=true$/, "", s); print s }'
}

# egress_gate_vault <vault-or-empty>: the standalone consent check. Sets VAULT;
# exits 3 on no config, disabled, no vault id, or no consent. Not a subshell:
# it loads CFG for the caller.
VAULT=""
egress_gate_vault() {
	VAULT="$1"
	load_config || unavailable "config not available (is VAULTMEM_BIN set?)"
	[ "$(cfg enabled false)" = "true" ] || unavailable "[ext.judge] enabled is not true"
	if [ -z "$VAULT" ]; then
		mktmp || unavailable "cannot create a temp dir"
		VAULT=$(resolve_vault) || unavailable "no vault id resolved; pass --vault <id>"
	fi
	[ "$(cfg_raw "vault.$VAULT.judge")" = "true" ] ||
		unavailable "vault $VAULT has not consented to egress (judge = true)"
}

# --- subcommand: <name> ----------------------------------------------------------

cmd_judge() {
	local name="$1" vault="" gate="" format="json" subject=""
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
		--vault | --gate | --format | --subject)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			case "$1" in
			--vault) vault="$2" ;;
			--gate) gate="$2" ;;
			--format) format="$2" ;;
			--subject) subject="$2" ;;
			esac
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	valid_name "$name" || usage_err "invalid judge name: $name"
	case "$format" in
	json | tsv) ;;
	*) usage_err "--format must be json or tsv" ;;
	esac

	local jfile problems gate_type
	jfile=$(judge_path "$name") || usage_err "no such judge: $name"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	problems=$(judge_problems "$jfile")
	[ -z "$problems" ] || unavailable "judge file $jfile is invalid: $(printf '%s' "$problems" | head -n 1)"
	if [ -n "$gate" ]; then
		gate_type=$(jq -r --arg q "$gate" '.questions[$q].type // ""' "$jfile")
		case "$gate_type" in
		boolean | choice) ;;
		"") usage_err "--gate: judge $name has no question named $gate" ;;
		*) usage_err "--gate: question $gate is a $gate_type question; only boolean and choice can gate" ;;
		esac
	fi

	# Egress gate. Everything below this block may touch the network; nothing
	# above it does. Order matters: consent is checked before the key is read.
	egress_gate_vault "$vault"
	vault="$VAULT"
	egress_ready

	local raw="$TMPD/state.raw" state="$TMPD/state" questions="$TMPD/questions.json" resp="$TMPD/resp.json"
	cat >"$raw"
	fit_state "$raw" "$state" "$(jq -r '.max_state_bytes // 24000' "$jfile")" "$(jq -r '.truncate // "head"' "$jfile")"
	# --gate picks the exit code; every question is still sent, so a caller
	# gating on one answer can read the others (nudge reads `kind`).
	jq '.questions' "$jfile" >"$questions" || unavailable "could not read the judge's questions"
	evaluate "$name" "$vault" "$subject" "$state" "$questions" "$gate" "$resp"
	local id="$CALL_ID"

	# Verdict: thresholds come from the judge file. min_confidence compares the
	# top choice's probability, not the gateway's `confidence` field.
	local verdict=""
	if [ -n "$gate" ]; then
		verdict=$(jq -r --arg q "$gate" --slurpfile judge "$jfile" '
			($judge[0].thresholds[$q] // {}) as $t
			| .answers[$q] as $a
			| if $a.type == "boolean" then
			    (if $a.probability >= ($t.yes // 0.85) then "yes"
			     elif $a.probability <= ($t.no // 0.15) then "no"
			     else "abstain" end)
			  elif $a.type == "choice" then
			    (if ($a.probabilities[$a.choice] // 0) >= ($t.min_confidence // 0.6)
			     then "yes" else "abstain" end)
			  else "abstain" end' "$resp") || verdict="abstain"
	fi

	if [ "$format" = "tsv" ]; then
		jq -r --slurpfile judge "$jfile" '
			.answers | to_entries[] | .key as $q | .value as $a
			| ($judge[0].thresholds[$q] // {}) as $t
			| if $a.type == "boolean" then
			    [$q, "boolean",
			     (if $a.probability >= ($t.yes // 0.85) then "yes"
			      elif $a.probability <= ($t.no // 0.15) then "no" else "abstain" end),
			     $a.probability]
			  elif $a.type == "choice" then [$q, "choice", $a.choice, ($a.probabilities[$a.choice] // "")]
			  else [$q, "score", $a.score, ""] end
			| @tsv' "$resp"
	else
		jq -c --arg id "$id" --arg judge "$name" --arg gate "$gate" --arg verdict "$verdict" '
			{ id: $id, judge: $judge, answers: .answers }
			+ (if $gate == "" then {} else { gate: { question: $gate, verdict: $verdict } } end)' "$resp"
	fi

	case "$verdict" in
	"" | yes) exit 0 ;;
	no) exit 1 ;;
	*) exit 2 ;;
	esac
}

# A standalone call resolves its vault with `vaultmem which`. A low-confidence
# guess (the default-vault fallback) is NOT consent to send: treat as unresolved.
resolve_vault() {
	local bin id err
	bin=$(vaultmem_bin) || return 1
	[ -n "$bin" ] || return 1
	mktmp || return 1
	err="$TMPD/which.err"
	id=$("$bin" which 2>"$err") || return 1
	[ -s "$err" ] && return 1
	[ -n "$id" ] || return 1
	printf '%s\n' "$id"
}

# --- vault data for route and dupes (always through VAULTMEM_BIN) -------------------

# vault_root <id>: the vault's root path from `vaultmem vaults`, no trailing slash.
vault_root() {
	local root
	root=$("$(vaultmem_bin)" vaults 2>/dev/null | awk -F'\t' -v id="$1" '$1 == id { print $2; exit }')
	printf '%s\n' "${root%/}"
}

# vault_mocs <id>: `name<TAB>one-liner` per MOC of that vault. A MOC is kept only
# when it resolves to a file under that vault's root, so a `mocs` listing that
# names another vault's hubs never reaches a request.
vault_mocs() {
	local bin id="$1" root name desc path
	bin=$(vaultmem_bin)
	root=$(vault_root "$id")
	[ -n "$root" ] || return 0
	"$bin" --vault "$id" mocs 2>/dev/null | awk '
		/^\(/ { next }
		/^[^ \t]/ { if (n != "") print n "\t" d; n = $0; d = ""; next }
		/^    / && n != "" && d == "" { d = $0; sub(/^ +/, "", d) }
		END { if (n != "") print n "\t" d }' |
		while IFS=$'\t' read -r name desc; do
			[ -n "$name" ] || continue
			path=$("$bin" --vault "$id" resolve "$name" 2>/dev/null) || continue
			case "$path" in
			"$root"/*) printf '%s\t%s\n' "$name" "$desc" ;;
			esac
		done
}

# criteria_json <tsv-file>: `key<TAB>text` lines as a choice criteria object. An
# empty text falls back to the key.
criteria_json() {
	jq -R -s 'split("\n") | map(select(length > 0) | split("\t")
		| { (.[0]): (if (.[1] // "") == "" then .[0] else .[1:] | join("\t") end) }) | add // {}' "$1"
}

# --- subcommand: route -------------------------------------------------------------

# Which vault, which folder, which MOC, for a summary on stdin. One request when
# one vault consents (the vault is known; category and moc ride together). Two
# when several consent: `vault` + `category` first, then `moc` for the chosen
# vault, because the MOC list depends on the vault. A low-confidence vault stops
# after the first request, so the summary never goes out a second time on a guess.
cmd_route() {
	local subject=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--subject)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			subject="$2"
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	local jfile problems
	jfile=$(judge_path route) || unavailable "judge file route.json not found"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	problems=$(judge_problems "$jfile")
	[ -z "$problems" ] || unavailable "judge file $jfile is invalid: $(printf '%s' "$problems" | head -n 1)"

	# Egress gate: only consenting vaults are ever named in, or receive, a request.
	load_config || unavailable "config not available (is VAULTMEM_BIN set?)"
	[ "$(cfg enabled false)" = "true" ] || unavailable "[ext.judge] enabled is not true"
	local vaults nv
	vaults=$(consenting_vaults)
	[ -n "$vaults" ] || unavailable "no vault has consented to egress (judge = true)"
	nv=$(printf '%s\n' "$vaults" | grep -c .)
	egress_ready

	local raw="$TMPD/state.raw" state="$TMPD/state" q="$TMPD/questions.json"
	local vcrit="$TMPD/vault-criteria.json" mcrit="$TMPD/moc-criteria.json"
	local resp1="$TMPD/resp-route.json" resp2="$TMPD/resp-moc.json"
	cat >"$raw"
	fit_state "$raw" "$state" "$(jq -r '.max_state_bytes // 8000' "$jfile")" "$(jq -r '.truncate // "head"' "$jfile")"

	local id label desc
	while IFS= read -r id; do
		label=$(cfg_raw "vault.$id.label")
		desc=$(cfg_raw "vault.$id.description")
		label="${label:-$id}"
		if [ -n "$desc" ]; then
			printf '%s\t%s: %s\n' "$id" "$label" "$desc"
		else
			printf '%s\t%s\n' "$id" "$label"
		fi
	done <<<"$vaults" >"$TMPD/vaults.tsv"
	criteria_json "$TMPD/vaults.tsv" >"$vcrit" || unavailable "could not build the vault criteria"

	local vault="" vault_p=1 asked_moc=false
	[ "$nv" -eq 1 ] && vault="$vaults"
	if [ -n "$vault" ]; then
		vault_mocs "$vault" >"$TMPD/mocs.tsv"
		criteria_json "$TMPD/mocs.tsv" >"$mcrit" || unavailable "could not build the MOC criteria"
		[ -s "$TMPD/mocs.tsv" ] && asked_moc=true
	else
		printf '{}\n' >"$mcrit"
	fi

	# Request 1. With one vault, the vault question is not asked.
	jq -n --slurpfile j "$jfile" --slurpfile vc "$vcrit" --slurpfile mc "$mcrit" \
		--arg askv "$([ -z "$vault" ] && echo true)" --arg askm "$asked_moc" '
		{ category: $j[0].questions.category }
		+ (if $askv == "true" then { vault: ($j[0].questions.vault + { criteria: $vc[0] }) } else {} end)
		+ (if $askm == "true" then { moc: ($j[0].questions.moc + { criteria: $mc[0] }) } else {} end)
		' >"$q" || unavailable "could not build the questions"
	local required="category"
	[ -z "$vault" ] && required="$required vault"
	[ "$asked_moc" = "true" ] && required="$required moc"
	evaluate route "$vault" "$subject" "$state" "$q" "$required" "$resp1"
	local call_id="$CALL_ID" moc_id=""

	if [ -z "$vault" ]; then
		vault=$(jq -r '.answers.vault.choice' "$resp1")
		vault_p=$(jq -r '.answers.vault.probabilities[.answers.vault.choice] // 0' "$resp1")
		# The model can only pick a vault it was offered; anything else is a bad
		# response, never a destination.
		printf '%s\n' "$vaults" | grep -qxF -- "$vault" || unavailable "route: the gateway chose a vault it was not offered"
	fi

	local min low=false
	min=$(jq -r '.thresholds.vault.min_confidence // 0.6' "$jfile")
	if awk -v p="$vault_p" -v m="$min" 'BEGIN { exit !(p < m) }'; then
		low=true
	fi

	# Request 2, several vaults only: the chosen vault's MOCs.
	if [ "$nv" -gt 1 ] && [ "$low" = "false" ]; then
		vault_mocs "$vault" >"$TMPD/mocs.tsv"
		if [ -s "$TMPD/mocs.tsv" ]; then
			criteria_json "$TMPD/mocs.tsv" >"$mcrit" || unavailable "could not build the MOC criteria"
			jq -n --slurpfile j "$jfile" --slurpfile mc "$mcrit" \
				'{ moc: ($j[0].questions.moc + { criteria: $mc[0] }) }' >"$q" ||
				unavailable "could not build the questions"
			evaluate route "$vault" "$subject" "$state" "$q" "moc" "$resp2"
			moc_id="$CALL_ID"
			asked_moc=true
		fi
	fi
	local moc_src="$resp1"
	[ -n "$moc_id" ] && moc_src="$resp2"

	jq -c -n --slurpfile r1 "$resp1" --slurpfile rm "$moc_src" --arg vault "$vault" \
		--argjson vp "$vault_p" --arg askm "$asked_moc" --arg id "$call_id" --arg moc_id "$moc_id" '
		def top($a): $a.probabilities[$a.choice] // null;
		($r1[0].answers) as $a
		| (if $askm == "true" then $rm[0].answers.moc else null end) as $m
		| { vault: $vault,
		    category: $a.category.choice,
		    moc: ($m.choice // null),
		    probabilities: { vault: $vp, category: top($a.category),
		                     moc: (if $m == null then null else top($m) end) },
		    id: $id }
		+ (if $moc_id == "" then {} else { moc_id: $moc_id } end)'

	[ "$low" = "true" ] && exit 2
	exit 0
}

# --- subcommand: dupes -------------------------------------------------------------

# dupes_query: the summary's first line as a search query. Punctuation becomes
# space (search terms are regexes), and at most 7 words are kept.
dupes_query() {
	head -n 1 "$1" | LC_ALL=C tr '[:punct:]' ' ' | awk '{ for (i = 1; i <= NF && i <= 7; i++) printf "%s%s", (i > 1 ? " " : ""), $i }'
}

# Does an existing note already cover the summary on stdin? Candidates come from
# the vault's own search, so only that vault's notes are ever in the request.
cmd_dupes() {
	local vault="" subject=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--vault | --subject)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			case "$1" in
			--vault) vault="$2" ;;
			--subject) subject="$2" ;;
			esac
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	local jfile problems
	jfile=$(judge_path dupes) || unavailable "judge file dupes.json not found"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	problems=$(judge_problems "$jfile")
	[ -z "$problems" ] || unavailable "judge file $jfile is invalid: $(printf '%s' "$problems" | head -n 1)"

	egress_gate_vault "$vault"
	vault="$VAULT"
	egress_ready

	local bin raw="$TMPD/summary.raw" query root
	bin=$(vaultmem_bin)
	cat >"$raw"
	query=$(dupes_query "$raw")
	root=$(vault_root "$vault")
	if [ -z "$query" ] || [ -z "$root" ]; then
		printf '[]\n'
		exit 0
	fi

	# First five distinct files, and only files under this vault's root.
	"$bin" --vault "$vault" --format json -n 5 "$query" 2>/dev/null |
		jq -r 'if type == "array" then
		         reduce (.[].file | strings) as $f ([]; if any(.[]; . == $f) then . else . + [$f] end) | .[]
		       else empty end' 2>/dev/null |
		while IFS= read -r path; do
			case "$path" in
			"$root"/*) printf '%s\n' "$path" ;;
			esac
		done | head -n 5 >"$TMPD/candidates"
	if [ ! -s "$TMPD/candidates" ]; then
		printf '[]\n'
		exit 0
	fi

	# State: the summary, then each candidate's vault-relative path, title, and
	# first 20 lines. Each part gets a fixed share of max_state_bytes, so a long
	# summary or note can never crowd a later candidate out of the request.
	local max n share sum_max i=0 path rel title state="$TMPD/state" part="$TMPD/part"
	max=$(jq -r '.max_state_bytes // 24000' "$jfile")
	n=$(grep -c . "$TMPD/candidates")
	sum_max=$((max / 4))
	share=$(((max - sum_max) / n - 64))
	[ "$share" -gt 0 ] || share=1
	{
		printf 'Summary:\n'
		fit_state "$raw" "$part" "$sum_max" head
		cat "$part"
	} >"$state"
	printf '{}\n' >"$TMPD/questions.json"
	while IFS= read -r path; do
		i=$((i + 1))
		rel="${path#"$root"/}"
		"$bin" cat "$path" --lines 20 2>/dev/null | awk '{ sub(/^ *[0-9]+\t/, ""); print }' >"$TMPD/excerpt"
		title=$(awk '/^# / { sub(/^# +/, ""); print; exit }' "$TMPD/excerpt")
		[ -n "$title" ] || title=$(basename "$rel" .md)
		{
			printf '\n\nCandidate c%s\nPath: %s\nTitle: %s\n\n' "$i" "$rel" "$title"
			cat "$TMPD/excerpt"
		} >"$TMPD/block"
		fit_state "$TMPD/block" "$part" "$share" head
		cat "$part" >>"$state"
		jq --slurpfile j "$jfile" --arg q "c$i" --arg c "c$i ($rel)" \
			'. + { ($q): ($j[0].questions.covers | .instructions |= gsub("\\{candidate\\}"; $c)) }' \
			"$TMPD/questions.json" >"$TMPD/q.next" || unavailable "could not build the questions"
		mv "$TMPD/q.next" "$TMPD/questions.json"
	done <"$TMPD/candidates"

	local required
	required=$(jq -r 'keys | join(" ")' "$TMPD/questions.json")
	evaluate dupes "$vault" "$subject" "$state" "$TMPD/questions.json" "$required" "$TMPD/resp.json"

	jq -c --rawfile paths "$TMPD/candidates" '
		.answers as $a
		| [ $paths | split("\n") | map(select(length > 0)) | to_entries[]
		    | { path: .value, probability: $a["c\(.key + 1)"].probability } ]
		| sort_by(-.probability)' "$TMPD/resp.json"
}

# --- subcommand: rerank ------------------------------------------------------------

# How well does each search candidate answer the query? The primitive under core's
# `search --rerank` and under `bench`. Candidates JSON on stdin, one score question
# per candidate id, `{id, scores}` on stdout. A candidate whose vault is not a
# consenting --vault is removed before the state is built, so none of its text
# reaches the request, and it is absent from `scores`.
RERANK_MAX=20
cmd_rerank() {
	local given="" v
	while [ $# -gt 0 ]; do
		case "$1" in
		--vault)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			given="$given$2"$'\n'
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	[ -n "$given" ] || usage_err "rerank needs at least one --vault <id>"
	local jfile problems
	jfile=$(judge_path rerank) || unavailable "judge file rerank.json not found"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	problems=$(judge_problems "$jfile")
	[ -z "$problems" ] || unavailable "judge file $jfile is invalid: $(printf '%s' "$problems" | head -n 1)"
	mktmp || unavailable "cannot create a temp dir"

	local in="$TMPD/rerank-in.json" kept="$TMPD/rerank-kept.json"
	cat >"$in"
	jq -e --argjson max "$RERANK_MAX" '
		def text: . == null or type == "string";
		type == "object" and (.query | type) == "string" and (.query | length) > 0
		and (.candidates | type) == "array" and (.candidates | length) <= $max
		and (.candidates | all(type == "object"
		  and (.id | type) == "string" and (.id | test("^[A-Za-z0-9_-]+$"))
		  and (.vault | type) == "string" and (.vault | length) > 0
		  and (.path | text) and (.title | text) and (.description | text) and (.head | text)
		  and (.matches == null or ((.matches | type) == "array" and (.matches | all(type == "string"))))))
		and ([.candidates[].id] | length == (unique | length))' "$in" >/dev/null 2>&1 ||
		usage_err "rerank: stdin must be {\"query\": \"...\", \"candidates\": [{\"id\", \"vault\", ...}]} with unique ids and at most $RERANK_MAX candidates"

	# Egress gate. A --vault counts only when it has consented; a candidate counts
	# only when its vault is one of those.
	load_config || unavailable "config not available (is VAULTMEM_BIN set?)"
	[ "$(cfg enabled false)" = "true" ] || unavailable "[ext.judge] enabled is not true"
	local ok=""
	while IFS= read -r v; do
		[ -n "$v" ] || continue
		[ "$(cfg_raw "vault.$v.judge")" = "true" ] || continue
		case $'\n'"$ok" in
		*$'\n'"$v"$'\n'*) ;;
		*) ok="$ok$v"$'\n' ;;
		esac
	done <<<"$given"
	[ -n "$ok" ] || unavailable "no --vault has consented to egress (judge = true)"
	jq --arg ok "$ok" '($ok | split("\n") | map(select(length > 0))) as $ok
		| .candidates |= map(select(.vault as $v | any($ok[]; . == $v)))' "$in" >"$kept" ||
		unavailable "could not filter the candidates"
	[ "$(jq '.candidates | length' "$kept")" -gt 0 ] || unavailable "no candidate from a consenting vault"
	egress_ready

	# State: the query, then per candidate its id, title, description, first lines,
	# and matched lines. The path is never sent. Over max_state_bytes: drop every
	# candidate's matched lines, then cut each candidate to an equal share, first
	# by shortening its first lines, so no candidate is crowded out.
	local max state="$TMPD/state" fitted="$TMPD/rerank-fitted.json"
	max=$(jq -r '.max_state_bytes // 32000' "$jfile")
	jq --argjson max "$max" '
		def cut($n): if $n <= 0 then ""
		  elif utf8bytelength <= $n then .
		  else .[:$n] | until(utf8bytelength <= $n;
		    .[:(length - ((utf8bytelength - $n) / 4 | ceil))]) end;
		def block($c; $m; $head):
		  "\n\nCandidate \($c.id)\nTitle: \($c.title // "")"
		  + (if ($c.description // "") == "" then "" else "\nDescription: \($c.description)" end)
		  + (if $head == "" then "" else "\nFirst lines:\n\($head)" end)
		  + (if $m and (($c.matches // []) | length) > 0
		     then "\nMatched lines:\n" + ($c.matches | map("- " + .) | join("\n")) else "" end);
		(.query | cut($max / 4 | floor)) as $q
		| ("Query: " + $q) as $hdr
		| .candidates as $cs
		| ($hdr + ($cs | map(block(.; true; .head // "")) | join(""))) as $full
		| ($hdr + ($cs | map(block(.; false; .head // "")) | join(""))) as $nomatch
		| if ($full | utf8bytelength) <= $max then { state: $full, truncated: ($q != .query) }
		  elif ($nomatch | utf8bytelength) <= $max then { state: $nomatch, truncated: true }
		  else ((($max - ($hdr | utf8bytelength)) / ($cs | length)) | floor) as $share
		    | { state: ($hdr + ($cs | map(. as $c
		          | ($share - (block($c; false; "") | utf8bytelength)
		             - ("\nFirst lines:\n" | utf8bytelength)) as $room
		          | block($c; false; (($c.head // "") | cut($room))) | cut($share)) | join(""))),
		        truncated: true }
		  end' "$kept" >"$fitted" || unavailable "could not build the state"
	jq -j '.state' "$fitted" >"$state"
	TRUNCATED=$(jq -r '.truncated' "$fitted")

	local q="$TMPD/questions.json" required vlist
	jq --slurpfile j "$jfile" '[.candidates[].id | . as $id
		| { ($id): ($j[0].questions.relevance | .instructions |= gsub("\\{candidate\\}"; $id)) }] | add' \
		"$kept" >"$q" || unavailable "could not build the questions"
	required=$(jq -r '[.candidates[].id] | join(" ")' "$kept")
	vlist=$(jq -r '[.candidates[].vault] | reduce .[] as $v ([]; if any(.[]; . == $v) then . else . + [$v] end) | join(",")' "$kept")
	evaluate rerank "$vlist" "" "$state" "$q" "$required" "$TMPD/resp-rerank.json"

	jq -c --arg id "$CALL_ID" --slurpfile k "$kept" '.answers as $a
		| { id: $id, scores: (reduce $k[0].candidates[].id as $c ({}; .[$c] = $a[$c].score)) }' \
		"$TMPD/resp-rerank.json"
}

# --- subcommand: bench -------------------------------------------------------------

# bench_note <path>: `T|D|H<TAB>text` lines for one note: its title (first `# `
# heading), frontmatter description, and first 5 non-blank body lines after the
# frontmatter and title, read through `vaultmem cat`.
bench_note() {
	"$(vaultmem_bin)" cat "$1" --lines 40 </dev/null 2>/dev/null | awk '
		{ sub(/^ *[0-9]+\t/, "") }
		NR == 1 && /^---[ \t]*$/ { fm = 1; next }
		fm && /^---[ \t]*$/ { fm = 0; next }
		fm {
			if ($0 ~ /^description:/) {
				d = $0; sub(/^description:[ \t]*/, "", d)
				if (d ~ /^".*"$/ || d ~ /^'\''.*'\''$/) d = substr(d, 2, length(d) - 2)
				print "D\t" d
			}
			next
		}
		!t && /^# / { s = $0; sub(/^# +/, "", s); print "T\t" s; t = 1; next }
		/^[ \t]*$/ { next }
		h < 5 { h++; print "H\t" $0 }'
}

# Search quality on your own fixture: plain search order versus reranked order,
# precision@5, recall@10, and MRR per query and overall, plus tokens, cost, and
# the model the gateway reported (the drift signal). Output is buffered, so an
# unavailable run prints nothing on stdout.
cmd_bench() {
	local fixture="" vault="" n=20 format=tsv
	while [ $# -gt 0 ]; do
		case "$1" in
		--fixture | --vault | -n | --format)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			case "$1" in
			--fixture) fixture="$2" ;;
			--vault) vault="$2" ;;
			-n) n="$2" ;;
			--format) format="$2" ;;
			esac
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	case "$n" in
	"" | *[!0-9]* | 0) usage_err "-n must be an integer from 1 to $RERANK_MAX" ;;
	esac
	[ "$n" -le "$RERANK_MAX" ] || usage_err "-n must be an integer from 1 to $RERANK_MAX"
	case "$format" in
	tsv | json) ;;
	*) usage_err "--format must be tsv or json" ;;
	esac
	fixture="${fixture:-${XDG_CONFIG_HOME:-$HOME/.config}/vaultmem/bench.tsv}"
	[ -f "$fixture" ] || usage_err "no fixture at $fixture (pass --fixture <tsv>)"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"

	egress_gate_vault "$vault"
	vault="$VAULT"
	egress_ready

	local bin root
	bin=$(vaultmem_bin)
	root=$(vault_root "$vault")
	[ -n "$root" ] || unavailable "vault $vault has no root in \`vaultmem vaults\`"

	local rows="$TMPD/bench-rows.jsonl" search="$TMPD/bench-search.json" files="$TMPD/bench-files"
	local cands="$TMPD/bench-cands.jsonl" in="$TMPD/bench-in.json" out="$TMPD/bench-out.json"
	local resp="$TMPD/resp-rerank.json" query rel path id title i rc nq=0
	: >"$rows"
	while IFS=$'\t' read -r query rel <&3; do
		query="${query%$'\r'}"
		rel="${rel%$'\r'}"
		case "$query" in
		"" | \#*) continue ;;
		esac
		[ -n "$rel" ] || usage_err "fixture line has no relevant paths: $query"
		nq=$((nq + 1))

		# Baseline: unique files in search order, under this vault's root only.
		"$bin" --vault "$vault" --format json -n "$n" "$query" </dev/null 2>/dev/null >"$search" ||
			printf '[]\n' >"$search"
		jq -r 'if type == "array" then
		         reduce (.[].file | strings) as $f ([]; if any(.[]; . == $f) then . else . + [$f] end) | .[]
		       else empty end' "$search" 2>/dev/null |
			while IFS= read -r path; do
				case "$path" in
				"$root"/*) printf '%s\n' "$path" ;;
				esac
			done | head -n "$n" >"$files"

		: >"$cands"
		rm -f "$resp" "$out"
		i=0
		while IFS= read -r path; do
			i=$((i + 1))
			id=$(printf 'c%02d' "$i")
			title=$(basename "$path" .md)
			bench_note "$path" | jq -R -s -c --arg id "$id" --arg vault "$vault" --arg path "$path" \
				--arg title "$title" --slurpfile s "$search" '
				split("\n") | map(select(length > 0) | { k: .[0:1], v: .[2:] }) as $l
				| { id: $id, vault: $vault, path: $path,
				    title: (first($l[] | select(.k == "T") | .v) // $title),
				    description: (first($l[] | select(.k == "D") | .v) // ""),
				    head: ([$l[] | select(.k == "H") | .v] | join("\n")),
				    matches: ([$s[0][]? | select(.file == $path) | .text | strings] | .[:2]) }' >>"$cands" ||
				unavailable "could not read candidate $path"
		done <"$files"

		if [ "$i" -gt 0 ]; then
			jq -s -c --arg q "$query" '{ query: $q, candidates: . }' "$cands" >"$in"
			(cmd_rerank --vault "$vault") <"$in" >"$out"
			rc=$?
			[ "$rc" -eq 0 ] || unavailable "rerank failed on query $nq (exit $rc)"
		else
			printf '{"scores":{}}\n' >"$out"
			printf '{}\n' >"$resp"
		fi

		jq -c -n --arg q "$query" --arg rel "$rel" --arg root "$root" --rawfile files "$files" \
			--slurpfile out "$out" --slurpfile resp "$resp" '
			def hits($l; $r): [$l[] | select(. as $x | any($r[]; . == $x))] | length;
			def metrics($l; $r):
			  { p_at_5: (hits($l[:5]; $r) / 5),
			    r_at_10: (hits($l[:10]; $r) / ($r | length)),
			    mrr: (first(range(0; $l | length) as $i | select(any($r[]; . == $l[$i])) | 1 / ($i + 1)) // 0) };
			($rel | split(",") | map(gsub("^ +| +$"; "")) | map(select(length > 0))) as $relp
			| ($relp | map($root + "/" + .)) as $r
			| ($files | split("\n") | map(select(length > 0))) as $base
			| ($out[0].scores // {}) as $s
			| ($base | to_entries
			   | sort_by(-(("c" + (if .key < 9 then "0" else "" end) + (.key + 1 | tostring)) as $id
			               | $s[$id] // -1))
			   | map(.value)) as $rr
			| { query: $q, relevant: $relp, candidates: ($base | length),
			    baseline: metrics($base; $r), reranked: metrics($rr; $r),
			    input_tokens: ($resp[0].usage.inputTokens // 0),
			    cost: ($resp[0].providerMetadata.gateway.cost // 0 | tonumber),
			    market_cost: ($resp[0].providerMetadata.gateway.marketCost // 0 | tonumber),
			    model: ($resp[0].model // null) }' >>"$rows" || unavailable "could not score query $nq"
	done 3<"$fixture"
	[ "$nq" -gt 0 ] || usage_err "fixture $fixture has no queries"

	local report="$TMPD/bench-report.json"
	jq -s -c --arg vault "$vault" --argjson n "$n" '
		def r4: . * 10000 | round / 10000;
		def r10: . * 10000000000 | round / 10000000000;
		def mean(f): map(f) | add / length | r4;
		def side(k): { p_at_5: mean(.[k].p_at_5), r_at_10: mean(.[k].r_at_10), mrr: mean(.[k].mrr) };
		{ model: ([.[].model | strings] | unique | if length == 0 then null else join(",") end),
		  vault: $vault, n: $n,
		  queries: map(del(.model) | .baseline |= map_values(r4) | .reranked |= map_values(r4)
		               | .cost |= r10 | .market_cost |= r10),
		  overall: { queries: length, relevant: (map(.relevant | length) | add),
		             candidates: (map(.candidates) | add),
		             baseline: side("baseline"), reranked: side("reranked"),
		             input_tokens: (map(.input_tokens) | add),
		             cost: (map(.cost) | add | r10), market_cost: (map(.market_cost) | add | r10) } }' \
		"$rows" >"$report" || unavailable "could not build the report"

	if [ "$format" = "json" ]; then
		cat "$report"
		return 0
	fi
	jq -r '
		"# model: \(.model // "unknown")  vault: \(.vault)  n: \(.n)",
		(["query", "candidates", "relevant", "base_p@5", "base_r@10", "base_mrr",
		  "rerank_p@5", "rerank_r@10", "rerank_mrr", "input_tokens", "cost", "market_cost"] | @tsv),
		(.queries[], (.overall + { query: "(all)" })
		 | [.query, .candidates, (.relevant | if type == "array" then length else . end),
		    .baseline.p_at_5, .baseline.r_at_10, .baseline.mrr,
		    .reranked.p_at_5, .reranked.r_at_10, .reranked.mrr,
		    .input_tokens, .cost, .market_cost] | @tsv)' "$report" |
		awk -F'\t' -v OFS='\t' '
			/^#/ || NR == 2 { print; next }
			{ for (i = 4; i <= 9; i++) $i = sprintf("%.4f", $i)
			  $11 = sprintf("%.8f", $11); $12 = sprintf("%.8f", $12); print }'
}

# --- subcommand: index-drift -------------------------------------------------------

# Does each Agent Index row still describe the note it points at? The primitive
# under core's `doctor --judge`. Rows JSON on stdin, one boolean question per row
# id, `{id, answers: {<row-id>: {probability}}}` on stdout, where probability is
# the chance the row is accurate. Core applies the `no` threshold itself.
INDEX_DRIFT_MAX=5
cmd_index_drift() {
	local vault=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--vault)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			vault="$2"
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	local jfile problems
	jfile=$(judge_path index-drift) || unavailable "judge file index-drift.json not found"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	problems=$(judge_problems "$jfile")
	[ -z "$problems" ] || unavailable "judge file $jfile is invalid: $(printf '%s' "$problems" | head -n 1)"
	mktmp || unavailable "cannot create a temp dir"

	local in="$TMPD/drift-in.json"
	cat >"$in"
	jq -e --argjson max "$INDEX_DRIFT_MAX" '
		def text: . == null or type == "string";
		type == "object" and (.rows | type) == "array"
		and (.rows | length) > 0 and (.rows | length) <= $max
		and (.rows | all(type == "object"
		  and (.id | type) == "string" and (.id | test("^[A-Za-z0-9_-]+$"))
		  and (.row | type) == "string" and (.row | length) > 0
		  and (.title | text) and (.frontmatter | text) and (.head | text)))
		and ([.rows[].id] | length == (unique | length))' "$in" >/dev/null 2>&1 ||
		usage_err "index-drift: stdin must be {\"rows\": [{\"id\", \"row\", \"title\", \"frontmatter\", \"head\"}]} with unique ids and 1 to $INDEX_DRIFT_MAX rows"

	egress_gate_vault "$vault"
	vault="$VAULT"
	egress_ready

	# State: per row its id, the index row text, the note's title, frontmatter,
	# and first lines. Over max_state_bytes, each row is cut to an equal share,
	# shortening its first lines first, so no row is crowded out.
	local max state="$TMPD/state" fitted="$TMPD/drift-fitted.json"
	max=$(jq -r '.max_state_bytes // 24000' "$jfile")
	jq --argjson max "$max" '
		def cut($n): if $n <= 0 then ""
		  elif utf8bytelength <= $n then .
		  else .[:$n] | until(utf8bytelength <= $n;
		    .[:(length - ((utf8bytelength - $n) / 4 | ceil))]) end;
		def block($r; $head):
		  "Row \($r.id)\nIndex row: \($r.row)\nNote title: \($r.title // "")"
		  + (if ($r.frontmatter // "") == "" then "" else "\nFrontmatter:\n\($r.frontmatter)" end)
		  + (if $head == "" then "" else "\nFirst lines:\n\($head)" end);
		.rows as $rs
		| ($rs | map(block(.; .head // "")) | join("\n\n")) as $full
		| if ($full | utf8bytelength) <= $max then { state: $full, truncated: false }
		  else ((($max - 2 * ($rs | length)) / ($rs | length)) | floor) as $share
		    | { state: ($rs | map(. as $r
		          | ($share - (block($r; "") | utf8bytelength)
		             - ("\nFirst lines:\n" | utf8bytelength)) as $room
		          | block($r; (($r.head // "") | cut($room))) | cut($share)) | join("\n\n")),
		        truncated: true }
		  end' "$in" >"$fitted" || unavailable "could not build the state"
	jq -j '.state' "$fitted" >"$state"
	TRUNCATED=$(jq -r '.truncated' "$fitted")

	local q="$TMPD/questions.json" required
	jq --slurpfile j "$jfile" '[.rows[].id | . as $id
		| { ($id): ($j[0].questions.accurate | .instructions |= gsub("\\{row\\}"; $id)) }] | add' \
		"$in" >"$q" || unavailable "could not build the questions"
	required=$(jq -r '[.rows[].id] | join(" ")' "$in")
	evaluate index-drift "$vault" "" "$state" "$q" "$required" "$TMPD/resp-drift.json"

	jq -c --arg id "$CALL_ID" --slurpfile i "$in" '.answers as $a
		| { id: $id, answers: (reduce $i[0].rows[].id as $r ({}; .[$r] = { probability: $a[$r].probability })) }' \
		"$TMPD/resp-drift.json"
}

# --- subcommand: prompt ------------------------------------------------------------

# The recall reflex gate for a UserPromptSubmit hook. Prompt on stdin (the hook's
# JSON `prompt` field, or raw text). Prints one line on a confident `asks_why`
# and nothing otherwise. Every outcome but a usage error exits 0, and stderr stays
# empty unless VAULTMEM_VERBOSE=1: a hook must never fail or chatter.
# shellcheck disable=SC2016  # the backticks are literal display text, not a substitution
PROMPT_LINE='vaultmem: this looks like a "why" question; run `vaultmem <query>` before re-deriving.'

prompt_skip() {
	[ "${VAULTMEM_VERBOSE:-}" = "1" ] && printf '%s: prompt: %s\n' "$PROG" "$1" >&2
	exit 0
}

# hook_judge_listed <name>: is <name> in [ext.judge] hook_judges (a comma list)?
hook_judge_listed() {
	case ",$(cfg hook_judges "" | tr -d '[:space:]')," in
	*,"$1",*) return 0 ;;
	esac
	return 1
}

cmd_prompt() {
	[ $# -eq 0 ] || usage_err "prompt takes no arguments (the prompt is on stdin)"
	command -v jq >/dev/null 2>&1 || prompt_skip "jq is not installed"
	mktmp || prompt_skip "cannot create a temp dir"
	local raw="$TMPD/prompt.raw" text="$TMPD/prompt.txt" vault
	cat >"$raw"

	# Gate: every check that can refuse runs before any network code.
	load_config || prompt_skip "config not available (is VAULTMEM_BIN set?)"
	[ "$(cfg enabled false)" = "true" ] || prompt_skip "[ext.judge] enabled is not true"
	hook_judge_listed prompt || prompt_skip "prompt is not in [ext.judge] hook_judges"
	vault=$(resolve_vault) || prompt_skip "no confident vault for $PWD"
	[ "$(cfg_raw "vault.$vault.judge")" = "true" ] ||
		prompt_skip "vault $vault has not consented to egress (judge = true)"

	# A JSON object is the hook payload: only its `prompt` field is sent, never
	# the session id, paths, or anything else in it. Anything else is raw text.
	if jq -e 'type == "object"' "$raw" >/dev/null 2>&1; then
		jq -j '.prompt | strings' "$raw" >"$text" 2>/dev/null || : >"$text"
	else
		cp "$raw" "$text"
	fi
	[ -n "$(tr -d '[:space:]' <"$text")" ] || prompt_skip "empty prompt"

	local err=/dev/null rc
	[ "${VAULTMEM_VERBOSE:-}" = "1" ] && err=/dev/stderr
	(cmd_judge prompt --vault "$vault" --gate asks_why --subject prompt) <"$text" >/dev/null 2>"$err"
	rc=$?
	[ "$rc" -eq 0 ] || prompt_skip "no confident yes (exit $rc)"
	printf '%s\n' "$PROMPT_LINE"
}

# --- subcommand: list ------------------------------------------------------------

cmd_list() {
	[ $# -eq 0 ] || usage_err "list takes no arguments"
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"
	local f name src desc seen=$'\n'
	for f in "$USER_DIR"/*.json "$SHIPPED_DIR"/*.json; do
		[ -f "$f" ] || continue
		name=$(basename "$f" .json)
		case "$seen" in
		*$'\n'"$name"$'\n'*) continue ;;
		esac
		seen="$seen$name"$'\n'
		src=shipped
		[ "$(dirname "$f")" = "$USER_DIR" ] && src=user
		desc=$(jq -r '.description // "" | tostring' "$f" 2>/dev/null) || desc="(does not parse)"
		printf '%s\t%s\t%s\n' "$name" "$src" "$desc"
	done | sort
}

# --- subcommand: log -------------------------------------------------------------

cmd_log() {
	local n=20
	while [ $# -gt 0 ]; do
		case "$1" in
		-n)
			[ $# -ge 2 ] || usage_err "-n needs a value"
			n="$2"
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	case "$n" in
	"" | *[!0-9]*) usage_err "-n must be a non-negative integer" ;;
	esac
	# Oldest first: the rotated generation, then the live file, so a tail spans
	# a rotation.
	local files
	files=$(log_files)
	[ -n "$files" ] || return 0
	printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 cat 2>/dev/null | tail -n "$n"
}

# --- subcommand: feedback ----------------------------------------------------------

# Oldest first: the rotated generation, then the live file. Prints nothing when
# neither exists.
log_files() {
	local f
	for f in "$LOG_FILE.1" "$LOG_FILE"; do
		[ -f "$f" ] && printf '%s\n' "$f"
	done
	return 0
}

# Offline: reads and appends to the local log, never the gateway. No egress
# gate, no config, no key, so it works with enabled = false.
cmd_feedback() {
	[ $# -eq 2 ] || usage_err "feedback takes <id> right|wrong"
	local id="$1" verdict="$2"
	case "$verdict" in
	right | wrong) ;;
	*) usage_err "feedback verdict must be right or wrong (got: $verdict)" ;;
	esac
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"

	# The id must name a decision row. Feedback rows carry no `judge` field, so
	# they can never satisfy this and feedback on feedback is rejected.
	local files found=""
	files=$(log_files)
	if [ -n "$files" ]; then
		found=$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 cat 2>/dev/null |
			jq -r --arg id "$id" -s 'map(select(.id == $id and has("judge") and (.feedback | type) != "string")) | length' 2>/dev/null)
	fi
	case "$found" in
	"" | 0)
		printf '%s: no decision row with id %s in the log\n' "$PROG" "$id" >&2
		exit 64
		;;
	esac

	# Append only. Existing rows, including earlier feedback on this id, are
	# never rewritten; `calibration` takes the last feedback row for an id.
	local row
	row=$(jq -nc --arg id "$id" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg fb "$verdict" \
		'{ id: $id, ts: $ts, feedback: $fb }') || unavailable "could not build the feedback row"
	log_append "$row"
}

# --- subcommand: calibration ---------------------------------------------------------

# Buckets the judged probability of each decision row that has feedback, so the
# owner can see whether a stated 0.9 really means 0.9 on their own data.
#
# Which probability: the top choice answer's probability when the judge has a
# choice question, else the highest boolean probability. That is the number a
# caller acts on (`groom --judge` gates on the choice), so it is the one worth
# calibrating.
cmd_calibration() {
	local judge_filter="" format="tsv"
	while [ $# -gt 0 ]; do
		case "$1" in
		--judge | --format)
			[ $# -ge 2 ] || usage_err "$1 needs a value"
			case "$1" in
			--judge) judge_filter="$2" ;;
			--format) format="$2" ;;
			esac
			shift 2
			;;
		*) usage_err "unknown argument: $1" ;;
		esac
	done
	case "$format" in
	tsv | json) ;;
	*) usage_err "--format must be tsv or json" ;;
	esac
	command -v jq >/dev/null 2>&1 || unavailable "jq is not installed"

	local files
	files=$(log_files)
	if [ -z "$files" ]; then
		# shellcheck disable=SC2016  # the backticks are literal display text, not a substitution
		printf 'no feedback rows yet: run `%s feedback <id> right|wrong` first\n' "$PROG"
		return 0
	fi

	# One jq pass over both files in order. Later rows win, so the latest
	# feedback for an id is the one that counts.
	local out
	out=$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 cat 2>/dev/null | jq -s -r \
		--arg judge "$judge_filter" --arg format "$format" '
		def prob:
		  .answers // {} | to_entries
		  | ((map(select(.value.type == "choice"))
		      | map(.value.probabilities[.value.choice] // 0) | max)
		     // (map(select(.value.type == "boolean"))
		         | map(.value.probability) | max));
		def bucket:
		  if . >= 0.9 then "0.9-1.0"
		  elif . >= 0.8 then "0.8-0.9"
		  elif . >= 0.7 then "0.7-0.8"
		  elif . >= 0.6 then "0.6-0.7"
		  elif . >= 0.5 then "0.5-0.6"
		  else null end;

		# Later rows overwrite earlier ones, so the newest feedback for an id wins.
		(reduce (.[] | select(has("judge")) | select($judge == "" or .judge == $judge)) as $d
		 ({}; .[$d.id] = $d)) as $decisions
		| (reduce (.[] | select(has("judge") | not)
		           | select(.feedback == "right" or .feedback == "wrong")) as $f
		   ({}; .[$f.id] = $f)) as $feedback
		| [ $feedback | to_entries[]
            | select($decisions[.key] != null)
            | { right: (.value.feedback == "right"),
                p: ($decisions[.key] | prob) } ]
		| map(select(.p != null and (.p | type) == "number") | . + { b: (.p | bucket) })
		| map(select(.b != null))
		| group_by(.b) | map({ bucket: .[0].b, n: length, right: (map(select(.right)) | length) })
		| map(. + { accuracy: (if .n == 0 then null else (.right / .n) end) })
		| sort_by(.bucket)
		| if length == 0 then "NONE"
		  elif $format == "json" then tojson
		  else (["bucket", "n", "right", "accuracy"] | @tsv),
		       (.[] | [.bucket, .n, .right, (.accuracy * 100 | round / 100 | tostring)] | @tsv)
		  end' 2>/dev/null) || out=""

	if [ -z "$out" ] || [ "$out" = "NONE" ]; then
		# shellcheck disable=SC2016  # the backticks are literal display text, not a substitution
		printf 'no feedback rows yet: run `%s feedback <id> right|wrong` first\n' "$PROG"
		return 0
	fi
	printf '%s\n' "$out"
}

# --- subcommand: doctor ----------------------------------------------------------

DOC_FAIL=0
doc_ok() { printf 'ok     %s\n' "$1"; }
doc_note() { printf 'note   %s\n' "$1"; }
doc_err() {
	local msg="$1"
	[ -n "$KEY" ] && msg="${msg//"$KEY"/[redacted]}"
	printf 'ERROR  %s\n' "$msg"
	DOC_FAIL=1
}

cmd_doctor() {
	local live=false
	while [ $# -gt 0 ]; do
		case "$1" in
		--live) live=true ;;
		*) usage_err "unknown argument: $1" ;;
		esac
		shift
	done

	local tool
	for tool in curl jq; do
		if command -v "$tool" >/dev/null 2>&1; then doc_ok "$tool found"; else doc_err "$tool is not installed"; fi
	done
	command -v jq >/dev/null 2>&1 || exit 1

	local enabled=false
	if load_config; then
		doc_ok "config read from \`$(vaultmem_bin) judge config\`"
		doctor_config
		enabled=$(cfg enabled false)
	else
		doc_err "config not available: \`vaultmem judge config\` failed (is VAULTMEM_BIN set?)"
	fi

	# A missing key only matters once the extension is switched on. A key file
	# that is too open is an exposed secret either way.
	if load_key; then
		doc_ok "key present (from $KEY_SRC)"
	else
		case "$KEY_ERR" in
		*"wider than 600"*) doc_err "$KEY_ERR" ;;
		*) if [ "$enabled" = "true" ]; then doc_err "$KEY_ERR"; else doc_note "$KEY_ERR"; fi ;;
		esac
	fi

	local f problems problem count=0
	for f in "$SHIPPED_DIR"/*.json "$USER_DIR"/*.json; do
		[ -f "$f" ] || continue
		count=$((count + 1))
		problems=$(judge_problems "$f")
		if [ -z "$problems" ]; then
			doc_ok "judge file $f"
		else
			while IFS= read -r problem; do doc_err "judge file $f: $problem"; done <<<"$problems"
		fi
	done
	[ "$count" -gt 0 ] || doc_err "no judge files found in $SHIPPED_DIR"

	if [ "$live" = "true" ]; then
		if [ "$DOC_FAIL" -ne 0 ]; then
			doc_err "--live skipped: fix the errors above first"
		elif [ "$enabled" != "true" ]; then
			doc_err "--live needs [ext.judge] enabled = true"
		else
			doctor_live
		fi
	fi
	exit "$DOC_FAIL"
}

# Validates [ext.judge] key names and value shapes. Core lint checks TOML shape
# only; key names are this extension's to own.
doctor_config() {
	local line key val known
	while IFS= read -r line; do
		case "$line" in
		ext.judge.*=*) ;;
		*) continue ;;
		esac
		key="${line%%=*}"
		key="${key#ext.judge.}"
		val="${line#*=}"
		known=false
		case " $KNOWN_KEYS " in
		*" $key "*) known=true ;;
		esac
		if [ "$known" != "true" ]; then
			doc_err "[ext.judge] unknown key: $key"
			continue
		fi
		case "$key" in
		enabled | zdr | log | rerank)
			case "$val" in
			true | false) ;;
			*) doc_err "[ext.judge] $key must be true or false (got: $val)" ;;
			esac
			;;
		timeout_ms)
			case "$val" in
			"" | *[!0-9]* | 0) doc_err "[ext.judge] timeout_ms must be a positive integer (got: $val)" ;;
			esac
			;;
		base_url)
			base_url_ok "$val" || doc_err "[ext.judge] base_url must be https, or http on a loopback host (got: $val)"
			;;
		model | key_file)
			[ -n "$val" ] || doc_err "[ext.judge] $key must not be empty"
			;;
		hook_judges)
			case "$val" in
			*[!A-Za-z0-9._,-]*) doc_err "[ext.judge] hook_judges must be a comma list of judge names (got: $val)" ;;
			esac
			;;
		esac
	done <<<"$CFG"
	[ "$DOC_FAIL" -eq 0 ] && doc_ok "[ext.judge] keys valid (enabled=$(cfg enabled false), zdr=$(cfg zdr true))"
	local consenting
	consenting=$(printf '%s\n' "$CFG" | awk -F= '/^vault\..*\.judge=true$/ { sub(/^vault\./, "", $1); sub(/\.judge$/, "", $1); printf "%s%s", s, $1; s = "," }')
	doc_note "vaults with judge = true: ${consenting:-none}"
}

# One 1-question call with a fixed synthetic state. No vault content is sent,
# so no vault consent is involved; `enabled` and a key are still required.
doctor_live() {
	local jfile zdr body resp released
	jfile=$(judge_path smoke) || {
		doc_err "--live: smoke judge file not found"
		return
	}
	mktmp || {
		doc_err "--live: cannot create a temp dir"
		return
	}
	body="$TMPD/live-body.json"
	resp="$TMPD/live-resp.json"
	zdr=$(cfg zdr true)
	[ "$zdr" = "false" ] || zdr=true
	jq -n --arg state "$LIVE_STATE" --slurpfile judge "$jfile" \
		--arg model "$(cfg model "typesafe-ai/jev")" --argjson zdr "$zdr" '
		{ model: $model, state: $state, questions: $judge[0].questions }
		+ (if $zdr then { providerOptions: { gateway: { zeroDataRetention: true } } } else {} end)
		' >"$body"
	gateway_post "$body" "$resp"
	if [ "$CURL_RC" -ne 0 ]; then
		doc_err "--live: transport failure (curl exit $CURL_RC)"
	elif [ "$HTTP_CODE" -ge 200 ] && [ "$HTTP_CODE" -lt 300 ] && jq -e '.answers | type == "object"' "$resp" >/dev/null 2>&1; then
		doc_ok "--live: HTTP $HTTP_CODE in ${LATENCY_MS}ms, model $(jq -r '.model // "?"' "$resp"), answers $(jq -c '.answers' "$resp")"
	else
		doc_err "--live: HTTP $HTTP_CODE $(jq -r '"\(.error.type // "bad_response"): \(.error.message // "unparseable body")"' "$resp" 2>/dev/null || printf 'bad_response: unparseable body')"
	fi
	# The gateway reports no versioned model id per call; the models listing is
	# the only version signal. Needs no auth, so the key is not sent.
	released=$(curl --silent --max-time 5 "$(cfg base_url "https://ai-gateway.vercel.sh")/v1/models" 2>/dev/null |
		jq -r --arg m "$(cfg model "typesafe-ai/jev")" '.data[]? | select(.id == $m) | .released // empty' 2>/dev/null)
	[ -n "$released" ] && doc_note "--live: model released (epoch) $released"
}

